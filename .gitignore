# ==============================================================================
#                              GIT IGNORE RULES
# ==============================================================================

# 1. Environment & Secret Credentials
.env
.env.local
.env.*.local

# 2. Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 4. Large Data Files & Machine Learning Checkpoints
PGN_File/
training_data/
models/
Analysis/
base_models/*.pb.gz
base_models/*.pb
stockfish/
*.pt
*.pgn
*.npz.gz
