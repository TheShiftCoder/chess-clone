# ==============================================================================
#                     ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' with real secrets to GitHub!
# ==============================================================================

# Lichess API Token for Bot Authentication
# Generate a Personal Access Token with 'Read/Write Board API' permissions from:
# https://lichess.org/account/oauth/token/create?scopes[]=board:play&description=Chess+Bot
LICHESS_API_TOKEN=your_lichess_api_token_here
